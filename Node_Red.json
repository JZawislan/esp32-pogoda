        "name": "function 4",
        "func": "let dane;\n\ntry {\n    dane = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    node.warn(\"To nie jest poprawny JSON: \" + msg.payload);\n    return null;\n}\n\nif (!dane || !dane.current || dane.current.temperature_2m === undefined) {\n    node.warn(\"Brak pola temperature_2m w JSONie z API!\");\n    return null;\n}\n\nmsg.payload = [\n    {\n        temp_c: parseFloat(dane.current.temperature_2m),\n    },\n    {\n        zrodlo: \"api\"\n    }\n];\n\nreturn msg;\n",
