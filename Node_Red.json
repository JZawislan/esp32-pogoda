    {
        "id": "5b6342fe008609fe",
        "type": "function",
        "z": "8e56d7d544d99517",
        "name": "function 1",
        "func": "\nlet dane;\n\ntry {\n    dane = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    node.warn(\"To nie jest poprawny JSON: \" + msg.payload);\n    return null;\n}\n\nif (dane.temp_c === undefined) {\n    node.warn(\"Brak pola temp_c w JSONie!\");\n    return null;\n}\n\nmsg.payload = [\n    {\n        \n        temp_c: parseFloat(dane.temp_c),\n        press_hpa: parseFloat(dane.press_hpa),\n        hum_perc: dane.hum_perc !== undefined ? parseFloat(dane.hum_perc) : null\n    },\n    {\n        \n        zrodlo: \"esp32_pokoj\"\n    }\n];\n\nreturn msg;",
