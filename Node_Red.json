        "func": "let dane;\n\ntry {\n    dane = (typeof msg.payload === \"string\") ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    node.warn(\"To nie jest poprawny JSON: \" + msg.payload);\n    return null;\n}\n\nif (dane.current === undefined || dane.current.temperature_2m === undefined) {\n    node.warn(\"Brak pola temperature_2m w JSONie!\");\n    return null;\n}\n\n// Konwertuje temperaturę na ciąg tekstowy (np. \"21.3\")\nmsg.payload = parseFloat(dane.current.temperature_2m);\nmsg.topic = \"Temperatura API (°C)\";\n\nreturn msg;\n\n",
