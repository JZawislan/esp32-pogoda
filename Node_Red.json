    {
        "id": "ef793f11b0f5df32",
        "type": "function",
        "z": "8e56d7d544d99517",
        "name": "function 2",
        "func": "\nlet dane = msg.payload;\n\nwhile (typeof dane === 'string') {\n    try {\n        dane = JSON.parse(dane);\n    } catch (e) {\n        node.warn(\"Nie udało się sparsować JSONa: \" + dane);\n        return null;\n    }\n}\n\n\nif (dane.temp_c === undefined) {\n    \n    node.warn(\"Brak pola temp_c! Otrzymany ładunek to: \" + JSON.stringify(dane));\n    return null;\n}\n\nmsg.payload = parseFloat(dane.temp_c);\nmsg.topic = \"Temperatura (°C)\";\n\nreturn msg;",
